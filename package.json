{
  "name": "omnitest",
  "version": "0.1.0",
  "private": true,
  "description": "One platform. Every test. Unified testing platform for modern web applications.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@omnitest/web",
    "build": "npm run build --workspace=@omnitest/cli && npm run build --workspace=@omnitest/web",
    "build:cli": "npm run build --workspace=@omnitest/cli",
    "build:web": "npm run build --workspace=@omnitest/web",
    "lint": "npm run lint --workspace=@omnitest/web",
    "typecheck": "npm run typecheck --workspace=@omnitest/cli && npm run typecheck --workspace=@omnitest/web",
    "typecheck:cli": "npm run typecheck --workspace=@omnitest/cli",
    "typecheck:web": "npm run typecheck --workspace=@omnitest/web",
    "omnitest": "node packages/cli/bin/omnitest.js"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
