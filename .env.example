# ==========================================
# OmniTest Platform - Environment Configuration
# ==========================================
# Copy this file to .env before starting any service.
# DO NOT commit .env or secrets to version control.

# Application Environment
NODE_ENV=development
PORT=4000
WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# For local development (zero-config SQLite):
DATABASE_URL="file:./dev.db"
# For PostgreSQL in staging/production:
# DATABASE_URL="postgresql://omnitest_user:omnitest_pass@localhost:5432/omnitest_dev?schema=public"

# ------------------------------------------
# Queue & Cache (Redis)
# ------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="super-secret-auth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="super-secret-jwt-key-change-in-production"

# AES-256-GCM Master Key for encrypting customer environment variables and secrets
# Generate with: openssl rand -hex 32 (must be exactly 64 hex characters)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------
# Object Storage (S3 / Cloudflare R2 / MinIO)
# ------------------------------------------
S3_ENDPOINT="http://localhost:9000" # MinIO local endpoint or AWS S3 endpoint
S3_REGION="us-east-1"
S3_BUCKET_NAME="omnitest-artifacts"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true" # Set true for MinIO/Localstack, false for AWS S3

# ------------------------------------------
# GitHub App Integration
# ------------------------------------------
GITHUB_APP_ID="12345"
GITHUB_CLIENT_ID="gh_client_id_placeholder"
GITHUB_CLIENT_SECRET="gh_client_secret_placeholder"
GITHUB_WEBHOOK_SECRET="gh_webhook_secret_placeholder"
GITHUB_PRIVATE_KEY_BASE64="base64_encoded_pem_private_key"

# ------------------------------------------
# Stripe Billing
# ------------------------------------------
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
STRIPE_PRO_MONTHLY_PRICE_ID="price_pro_monthly_placeholder"
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID="price_enterprise_monthly_placeholder"

# ------------------------------------------
# AI Diagnostics Service (Phase 8+)
# ------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# ------------------------------------------
# Worker Fleet Configuration
# ------------------------------------------
WORKER_CONCURRENCY=5
WORKER_TIMEOUT_SECONDS=600
PLAYWRIGHT_HEADLESS=true
